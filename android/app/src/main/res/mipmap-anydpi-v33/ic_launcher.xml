<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon variant (API 33+). The monochrome silhouette lets Android
     tint the shield with the user's wallpaper-derived theme colours while the
     standard white/navy/gold layers stay available on older launchers. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
